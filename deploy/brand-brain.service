# systemd unit for the Brand Brain AI service.
#
# Install:
#   sudo cp /opt/brand-brain/deploy/brand-brain.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now brand-brain
#
# Adjust User/Group/WorkingDirectory if you deploy somewhere other than
# /opt/brand-brain with a "deploy" user.

[Unit]
Description=ScaleSerum Brand Brain AI service (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=deploy
Group=deploy
WorkingDirectory=/opt/brand-brain

# Config comes from /opt/brand-brain/.env — app.py calls load_dotenv() at startup
# and WorkingDirectory is set, so systemd does not need to parse the file itself.
# (Uncomment the next line only if you want the vars in the unit's environment too;
# a syntax error in .env would then stop the service from starting at all.)
# EnvironmentFile=/opt/brand-brain/.env

# Bind to localhost only — Nginx/Caddy terminates TLS and proxies to this port.
# Change to 0.0.0.0 only if nothing is fronting the service.
ExecStart=/opt/brand-brain/.venv/bin/uvicorn app:app \
    --host 127.0.0.1 \
    --port 3001 \
    --workers 2 \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1

Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=brand-brain

# --- hardening -------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/opt/brand-brain

[Install]
WantedBy=multi-user.target
