# Example Nginx site for the Brand Brain AI service.
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/brand-brain
#   sudo ln -s /etc/nginx/sites-available/brand-brain /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d api.yourdomain.com     # TLS
#
# Replace api.yourdomain.com with your real hostname.

server {
    listen 80;
    listen [::]:80;
    server_name api.yourdomain.com;

    # certbot replaces this block with a 301 to https once TLS is issued.
    location / {
        proxy_pass http://127.0.0.1:3001;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # /api/script-lab/test-script takes ~15-25s (45s upstream Gemini timeout).
        # Anything below 60s here will cut the connection before the AI answers.
        proxy_connect_timeout 15s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        proxy_buffering off;
    }

    # Health endpoint is unauthenticated; keep it out of the access log.
    location = /health {
        proxy_pass http://127.0.0.1:3001/health;
        access_log off;
    }

    client_max_body_size 1m;
}
